# Copy to .env — never commit real keys.
# For production, route DeepSeek calls through your own backend instead of shipping the key in the app.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Scan API (the Python server in /server). On a real phone use your Mac's LAN IP, not localhost.
SCAN_API_URL=http://localhost:8000
